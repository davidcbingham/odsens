# odsens.com — environment variables
# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Supabase (StudioBing account) ---
SUPABASE_URL=                        # https://<ref>.supabase.co  (prod ref: dllbekulbimblrsrxuyv)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; never expose to the browser
NEXT_PUBLIC_SUPABASE_URL=            # same as SUPABASE_URL (browser-safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # same as SUPABASE_ANON_KEY (browser-safe)

# --- Google OAuth (for Supabase Auth "Sign in with Google") ---

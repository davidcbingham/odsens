GOOGLE_OAUTH_CLIENT_SECRET=

# --- YouTube Data API v3 (same Google Cloud project as OAuth) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCo3X_c7MqfC_ub-sMJZmmOA

# --- Modrinth (public API; no key, but a descriptive User-Agent is required) ---
MODRINTH_USER=OddSense
MODRINTH_USER_AGENT="odsens.com/0.1 (david@studiobing.com)"

# --- CurseForge for Studios API (console.curseforge.com) ---
CURSEFORGE_API_KEY=

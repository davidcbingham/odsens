# odsens.com — environment template — copy to .env (gitignored) and fill in. Never commit real values.
# Boot-required (8, ADR-0002 #18): NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# NEXT_PUBLIC_SITE_URL, CRON_SECRET, MODRINTH_USER, MODRINTH_USER_AGENT, YOUTUBE_CHANNEL_ID — plus HASH_SECRET from S1.1
# (9 names; ADR-0012). Everything else is optional
# (feature degrades) unless the slice that reads it says otherwise (docs/build/01-architecture.md §7 env matrix).

# --- Supabase (project odsens, ref dllbekulbimblrsrxuyv) ---
SUPABASE_URL=https://dllbekulbimblrsrxuyv.supabase.co    # CLI only (supabase link/config); not read by lib/env.ts
SUPABASE_ANON_KEY=    # CLI only
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://dllbekulbimblrsrxuyv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# On Vercel previews the Preview env carries the persistent `staging` Supabase branch's keys under Supabase's new names (ADR-0010);
# lib/env.ts + lib/env/public.ts accept them as aliases for the two names above (canonical wins when both are set; ADR-0010):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=    # alias for NEXT_PUBLIC_SUPABASE_ANON_KEY (sb_publishable_...)
# SUPABASE_SECRET_KEY=                     # alias for SUPABASE_SERVICE_ROLE_KEY (sb_secret_..., acts as service_role)
# --- Google Cloud project odsens (CLI only: `supabase config push` reads them; the app never does) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=    # optional: unset → RSS-only sync, no view counts
YOUTUBE_CHANNEL_ID=UCo3X_c7MqfC_ub-sMJZmmOA
# --- Modrinth (no key) ---
MODRINTH_USER=OddSense
MODRINTH_USER_AGENT="odsens.com/0.1 (david@studiobing.com)"
# --- CurseForge for Studios — console.curseforge.com ---
CURSEFORGE_API_KEY=    # [ ] TODO — optional forever (04 §3.2 no-key path)
# --- Ko-fi ---
KOFI_PAGE=oddsense    # seeds site_settings.kofi_page only (S1.9)
KOFI_WEBHOOK_VERIFICATION_TOKEN=    # Phase 2 (S2.1) — not read in v1
# --- Notifications (S1.5) ---
RESEND_API_KEY=    # [ ] TODO (resend.com → API Keys)
NOTIFY_FROM_EMAIL=allay@odsens.com
DISCORD_WEBHOOK_URL=    # [ ] TODO (Discord channel → Integrations → Webhooks); seeds site_settings only
# --- Vercel cron auth ---
CRON_SECRET=
# --- Hashing (S1.1+, server-only, ≥32 random bytes; ADR-0002 C13/A14) ---
HASH_SECRET=
# --- Sentry (S1.10) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000    # production + local value; on Vercel previews derived from VERCEL_BRANCH_URL (ADR-0010)
# --- Tooling (documentation only — commented so it is not a parsed name; not read by lib/env.ts, not a T-UNIT-35 name) ---
# deploy-checker sends this as the x-vercel-protection-bypass header to fetch Deployment-Protected previews
# (Vercel → Project → Deployment Protection → Protection Bypass for Automation). Never a schema key; never in the app.
# VERCEL_AUTOMATION_BYPASS_SECRET=    # tooling-only; lives in Vercel + David's .env, never in this template's name set
# --- Test-only (never set in Vercel): E2E=1 enables /__test/throw; *_API_BASE point adapters at the fixture server :4010 ---
E2E=
MODRINTH_API_BASE=
CURSEFORGE_API_BASE=
YOUTUBE_API_BASE=
YOUTUBE_RSS_BASE=
OEMBED_BASE=
DISCORD_API_BASE=
RESEND_API_BASE=

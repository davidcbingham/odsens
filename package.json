{
  "name": "odsens",
  "version": "0.1.0",
  "private": true,
  "description": "odsens.com — OddSense's portfolio site",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check . && tsc --noEmit && node scripts/contrast.mjs --check styles/ && node scripts/check-fixtures.mjs && node scripts/check-test-ids.mjs && node scripts/check-client-islands.mjs",
    "format": "prettier --write .",
    "contrast": "node scripts/contrast.mjs",
    "test": "pnpm test:unit && pnpm test:db",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "email": "echo \"React Email preview arrives in S1.5 (pnpm email dev)\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
